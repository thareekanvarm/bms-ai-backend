    "deploy:production": "wrangler deploy --env production",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.53.0",
    "hono": "^4.9.8",
    "quickjs-emscripten": "^0.31.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250924.0",
    "@types/node": "^20.19.9",
    "typescript": "^5.3.3",
    "wrangler": "^4.39.0"
  }
}
