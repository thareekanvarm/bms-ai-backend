{
  "name": "bms-ai-backend",
  "version": "1.0.0",
  "description": "Minimal function execution backend with TypeScript and QuickJS for Cloudflare Workers",
  "main": "src/worker.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "deploy": "wrangler deploy",
